#!/bin/bash
# rawproject (server): manage per-project "Raw" datasets with short snapshot retention
# Usage:
#   sudo rawproject create "Trae/YouTube/Darth Revan Gaming/Videos/AceCombat8/Mission 3"
#   sudo rawproject preview "Trae/YouTube/Darth Revan Gaming/Videos/AceCombat8/Mission 3"
#   sudo rawproject finish [--yes] "Trae/YouTube/Darth Revan Gaming/Videos/AceCombat8/Mission 3"
#   rawproject list
#
# Optional environment variable:
#   RAWPROJECT_NFS_FALLBACK=0   never stop nfs-server as a last resort (default 1)
set -euo pipefail

POOL="storage"
PARENT="${POOL}/raw"
ROOT="/mnt/MergedStorage"
OWNER="awesomeshot5051"
NFS_UNIT="nfs-server"
NFS_FALLBACK="${RAWPROJECT_NFS_FALLBACK:-1}"

usage() {
    echo "Usage: rawproject create|preview|finish [--yes] \"<project path relative to ${ROOT}>\""
    echo "       rawproject list"
    exit 1
}

slug() {
    printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_' | tr -s '_'
}

clean_path() {
    local p="${1#/}"
    p="${p%/}"
    if [[ -z "$p" || "$p" == *..* || "$p" =~ [[:cntrl:]] ]]; then
        echo "Invalid project path." >&2
        exit 1
    fi
    local real
    real="$(realpath -m "${ROOT}/${p}")"
    if [[ "$real" != "${ROOT}/"* ]]; then
        echo "Path resolves outside ${ROOT}." >&2
        exit 1
    fi
    printf '%s' "$p"
}

ensure_parent() {
    if ! zfs list -H -o name "$PARENT" >/dev/null 2>&1; then
        zfs create -o canmount=off -o mountpoint=none \
            -o recordsize=1M -o compression=lz4 -o atime=off "$PARENT"
        echo "Created container dataset ${PARENT}"
    fi
}

# Create a directory path like mkdir -p, but give every directory that did not
# exist before to OWNER instead of leaving it owned by root. Directories that
# already existed are left exactly as they were.
make_dirs_owned() {
    local target="$1" d="$1" n
    local -a created=()
    while [[ ! -d "$d" ]]; do
        created+=("$d")
        d="$(dirname "$d")"
    done
    mkdir -p "$target"
    for n in ${created[@]+"${created[@]}"}; do
        chown "${OWNER}:${OWNER}" "$n"
        chmod 775 "$n"
    done
}

# Ask nfsd to let go of a path. The crossmnt export on the parent makes nfsd
# keep a kernel reference to nested datasets that lsof and fuser cannot see.
release_nfs_holds() {
    local mp="$1"
    exportfs -f 2>/dev/null || true
    if [[ -w /proc/fs/nfsd/unlock_filesystem ]]; then
        printf '%s\n' "$mp" > /proc/fs/nfsd/unlock_filesystem 2>/dev/null || true
    fi
}

# Pull out the --yes flag so it can appear anywhere
YES=0
ARGS=()
for a in "$@"; do
    if [[ "$a" == "--yes" ]]; then
        YES=1
    else
        ARGS+=("$a")
    fi
done
set -- ${ARGS[@]+"${ARGS[@]}"}

cmd="${1:-}"
case "$cmd" in
    list)
        zfs list -r -o name,used,refer,mountpoint "$PARENT"
        ;;

    create)
        [[ $# -eq 2 ]] || usage
        [[ $EUID -eq 0 ]] || { echo "Run with sudo." >&2; exit 1; }
        rel="$(clean_path "$2")"
        name="$(slug "$rel")"
        ds="${PARENT}/${name}"
        mp="${ROOT}/${rel}/Raw"

        if zfs list -H -o name "$ds" >/dev/null 2>&1; then
            echo "Dataset ${ds} already exists." >&2
            exit 1
        fi
        if [[ -d "$mp" && -n "$(ls -A "$mp")" ]]; then
            echo "${mp} exists and is not empty. Move or rename it first." >&2
            exit 1
        fi

        ensure_parent
        make_dirs_owned "${ROOT}/${rel}"
        zfs create -o mountpoint="$mp" "$ds"
        chown "${OWNER}:${OWNER}" "$mp"
        chmod 775 "$mp"
        echo "Created ${ds} mounted at ${mp}"
        ;;

    preview)
        [[ $# -eq 2 ]] || usage
        [[ $EUID -eq 0 ]] || { echo "Run with sudo." >&2; exit 1; }
        rel="$(clean_path "$2")"
        name="$(slug "$rel")"
        ds="${PARENT}/${name}"

        if ! zfs list -H -o name "$ds" >/dev/null 2>&1; then
            echo "Dataset ${ds} does not exist." >&2
            exit 1
        fi
        echo "This would permanently destroy ${ds} and all of its snapshots:"
        zfs destroy -rnv "$ds"
        ;;

    finish)
        [[ $# -eq 2 ]] || usage
        [[ $EUID -eq 0 ]] || { echo "Run with sudo." >&2; exit 1; }
        rel="$(clean_path "$2")"
        name="$(slug "$rel")"
        ds="${PARENT}/${name}"
        mp="${ROOT}/${rel}/Raw"

        if ! zfs list -H -o name "$ds" >/dev/null 2>&1; then
            echo "Dataset ${ds} does not exist." >&2
            exit 1
        fi

        if [[ $YES -ne 1 ]]; then
            echo "This will permanently destroy ${ds} and all of its snapshots:"
            zfs destroy -rnv "$ds"
            echo
            read -r -p "Type the dataset name to confirm (${name}): " answer
            if [[ "$answer" != "$name" ]]; then
                echo "Cancelled."
                exit 1
            fi
        fi

        # Clones cannot be fixed by releasing mounts, so stop early and do not
        # disturb NFS for a failure that bouncing nfsd would never solve.
        clones="$(zfs get -H -o value clones "$ds" 2>/dev/null || true)"
        if [[ -n "$clones" && "$clones" != "-" ]]; then
            echo "${ds} has clones: ${clones}" >&2
            echo "Promote or destroy the clones first." >&2
            exit 1
        fi

        errfile="$(mktemp)"
        nfs_stopped=0
        cleanup() {
            rm -f "$errfile"
            if [[ $nfs_stopped -eq 1 ]]; then
                systemctl start "$NFS_UNIT" || true
            fi
        }
        trap cleanup EXIT

        destroyed=0

        # Stage 1: release nfsd's hold on the nested mount, then retry.
        for attempt in 1 2 3; do
            release_nfs_holds "$mp"
            if zfs destroy -r "$ds" 2>"$errfile"; then
                destroyed=1
                break
            fi
            echo "Attempt ${attempt} failed: $(cat "$errfile")"
            sleep 2
        done

        # Stage 2: briefly stop nfs-server, which drops every kernel reference.
        # NFS is always started again afterward, even if the destroy fails.
        if [[ $destroyed -ne 1 && "$NFS_FALLBACK" == "1" ]]; then
            echo "Still busy. Stopping ${NFS_UNIT} briefly to release the dataset."
            nfs_stopped=1
            systemctl stop "$NFS_UNIT"
            sleep 1
            if zfs destroy -r "$ds" 2>"$errfile"; then
                destroyed=1
            else
                echo "Destroy failed with NFS stopped: $(cat "$errfile")" >&2
            fi
            systemctl start "$NFS_UNIT" || true
            nfs_stopped=0
        fi

        if [[ $destroyed -ne 1 ]]; then
            echo "Dataset is still busy. Current holders of ${mp}:" >&2
            fuser -vm "$mp" 2>&1 || true
            echo "Check for another NFS client with the nested path mounted," >&2
            echo "or a local process inside it, then rerun." >&2
            exit 1
        fi

        rmdir "$mp" 2>/dev/null || true
        echo "Destroyed ${ds}. Space is free immediately."
        ;;

    *)
        usage
        ;;
esac
