#!/bin/bash
# disablesuspend: hold off the nightly suspend.
# Usage: disablesuspend                 (24 hours)
#        disablesuspend <n> [sec|min|hr]
#        disablesuspend clear

LOCKFILE="/tmp/suspend_disabled"

if [ "${1:-}" = "clear" ]; then
    rm -f "$LOCKFILE"
    echo "Suspend hold cleared."
    exit 0
fi

if [ -z "${1:-}" ]; then
    SECS=86400
else
    NUM=$1
    UNIT=${2,,}
    if ! [[ "$NUM" =~ ^[0-9]+$ ]]; then
        echo "Amount must be a whole number."
        exit 1
    fi
    case $UNIT in
        ""|sec|second|seconds ) SECS=$NUM ;;
        min|mins|minute|minutes ) SECS=$((NUM * 60)) ;;
        hr|hrs|hour|hours ) SECS=$((NUM * 3600)) ;;
        * )
            echo "Unsupported time unit: $UNIT"
            exit 1
            ;;
    esac
fi

NEW=$(( $(date +%s) + SECS ))

# Never shorten an existing hold
OLD=0
if [ -f "$LOCKFILE" ]; then
    OLD=$(cat "$LOCKFILE" 2>/dev/null)
    [[ "$OLD" =~ ^[0-9]+$ ]] || OLD=0
fi
[ "$OLD" -gt "$NEW" ] && NEW=$OLD

rm -f "$LOCKFILE"
echo "$NEW" > "$LOCKFILE"
chmod 644 "$LOCKFILE"
echo "Suspend disabled until $(date -d "@$NEW" '+%F %T')."
